# Required: use an HTTPS URL reachable by the simulator or physical device.
# Cleartext HTTP is accepted only by a local development runtime.
# Configure development, preview, and production values in their matching EAS environments.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Public OAuth client metadata, supplied by the owner for each EAS environment.
# These values identify OAuth clients; they are not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
